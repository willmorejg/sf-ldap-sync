# Build stage: compile and package the Quarkus app (JVM mode) with the Gradle wrapper.
FROM docker.io/library/eclipse-temurin:25-jdk AS build
WORKDIR /src
COPY gradlew settings.gradle build.gradle gradle.properties ./
COPY gradle ./gradle
RUN ./gradlew --no-daemon -q dependencies > /dev/null || true
COPY src ./src
# Tests need ../openldap/ldif (outside this build context); run them with
# `./gradlew build` from the project checkout before building the image.
RUN ./gradlew --no-daemon build -x test

# Runtime stage.
FROM docker.io/library/eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /src/build/quarkus-app/ /app/
RUN mkdir -p /work/inbox && chown -R 1001:0 /app /work
USER 1001
ENV CSV_INBOX=/work/inbox
EXPOSE 8080
ENTRYPOINT ["java", "-Dquarkus.http.host=0.0.0.0", "-jar", "/app/quarkus-run.jar"]
