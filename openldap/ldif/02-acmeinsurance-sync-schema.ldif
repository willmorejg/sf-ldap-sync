# Additions for automated provisioning. Kept as a separate schema entry so it
# can be added to an existing server without touching cn=acmeinsurance:
#   ldapadd -Y EXTERNAL -H ldapi:/// -f 02-acmeinsurance-sync-schema.ldif
#
# acmeSyncManaged marks an entry as owned by a sync source. The sync only ever
# updates, deactivates or deletes entries whose acmeSource it owns; entries made
# by hand (phpLDAPadmin, ldapadd) carry no acmeSource and are never touched.
dn: cn=acmeinsurance-sync,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: acmeinsurance-sync
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1.9 NAME 'acmeSource'
  DESC 'Source that owns this entry: salesforce, csv, or manual (hand-made)'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{32}
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1.10 NAME 'acmeDeactivated'
  DESC 'When the owning source deactivated (locked) this entry'
  EQUALITY generalizedTimeMatch
  ORDERING generalizedTimeOrderingMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.24
  SINGLE-VALUE )
olcObjectClasses: ( 1.3.6.1.4.1.99999.1.2.9 NAME 'acmeSyncManaged'
  DESC 'Entry maintained by an automated sync source'
  SUP top AUXILIARY
  MAY ( acmeSalesforceId $ acmeSource $ acmeDeactivated ) )
