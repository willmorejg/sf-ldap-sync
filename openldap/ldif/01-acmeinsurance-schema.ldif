# Acme Insurance custom schema (OpenLDAP 2.5/2.6, cn=config format)
#
# Same definitions as the Nov 2026 schema design (acmeUser, acmeAccountAccess,
# acmeMemberAccess, acmeAccount and its agency/agreement/book/client subclasses).
#
# OID arc 1.3.6.1.4.1.99999 is a PLACEHOLDER. Replace 99999 with Acme Insurance's
# IANA Private Enterprise Number before this goes anywhere permanent.
#   .1.1.x = attribute types   (.2 to .5 were used by an earlier draft; left unused)
#   .1.2.x = object classes
dn: cn=acmeinsurance,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: acmeinsurance
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1.1 NAME 'acmeUserType'
  DESC 'User type: internal, agent, member, other'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{16}
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1.6 NAME 'acmePolicyNumber'
  DESC 'Policy number a member is authorized for (multi-valued)'
  EQUALITY caseIgnoreMatch
  SUBSTR caseIgnoreSubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{64} )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1.7 NAME 'acmeSalesforceId'
  DESC 'ID of the corresponding Salesforce record (case-sensitive)'
  EQUALITY caseExactMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{18}
  SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1.8 NAME 'acmeAccountDN'
  DESC 'DN of an account entry the user is authorized for (multi-valued)'
  EQUALITY distinguishedNameMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )
olcObjectClasses: ( 1.3.6.1.4.1.99999.1.2.1 NAME 'acmeUser'
  DESC 'Any Acme Insurance user; carries the user type'
  SUP top AUXILIARY
  MUST acmeUserType )
olcObjectClasses: ( 1.3.6.1.4.1.99999.1.2.2 NAME 'acmeAccountAccess'
  DESC 'Account-level authorization for internal and agent users'
  SUP top AUXILIARY
  MAY acmeAccountDN )
olcObjectClasses: ( 1.3.6.1.4.1.99999.1.2.3 NAME 'acmeMemberAccess'
  DESC 'Policy-level authorization for member users'
  SUP top AUXILIARY
  MAY acmePolicyNumber )
olcObjectClasses: ( 1.3.6.1.4.1.99999.1.2.4 NAME 'acmeAccount'
  DESC 'Any account entry; cn holds the business identifier'
  SUP top STRUCTURAL
  MUST cn
  MAY ( acmeSalesforceId $ displayName $ description ) )
olcObjectClasses: ( 1.3.6.1.4.1.99999.1.2.5 NAME 'acmeAgencyAccount'
  DESC 'Agency; parent of agreements'
  SUP acmeAccount STRUCTURAL )
olcObjectClasses: ( 1.3.6.1.4.1.99999.1.2.6 NAME 'acmeAgreementAccount'
  DESC 'Agreement; child of an agency, parent of books'
  SUP acmeAccount STRUCTURAL )
olcObjectClasses: ( 1.3.6.1.4.1.99999.1.2.7 NAME 'acmeBookAccount'
  DESC 'Book; child of an agreement'
  SUP acmeAccount STRUCTURAL )
olcObjectClasses: ( 1.3.6.1.4.1.99999.1.2.8 NAME 'acmeClientAccount'
  DESC 'Client; internally generated ID, outside the agency hierarchy'
  SUP acmeAccount STRUCTURAL )
