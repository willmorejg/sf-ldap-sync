# .gitignore for acmeinsurance-ldap-sync
# Patterns without a leading "/" match at any depth; "/" anchors to the repo root.
# Check a path with: git check-ignore -v <path>

### Secrets and local configuration ###
# Real credentials live in .env; .env.example is the committed template.
.env
.env.*
!.env.example
# Private keys and keystores (the auth service generates its signing key at runtime).
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
keys/

### Runtime data ###
# CSV drops contain personal data. Keep the folder layout, never the files.
/inbox/**
!/inbox/**/
!/inbox/**/.gitkeep

### Gradle ###
.gradle/
build/
# Quarkus dev mode
.quarkus/

### Java ###
*.class
*.jar
# The Gradle wrapper jar must be committed (needed to bootstrap ./gradlew).
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
*.hprof

### Logs and temporary files ###
*.log
logs/
*.tmp
*.bak
*.orig
*.swp
*~

### IDEs ###
# VS Code: share project settings, ignore personal state.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
# Eclipse / VS Code Java language server (writes compiled output to bin/)
/sync/bin/
/auth/bin/
.classpath
.project
.settings/
.factorypath
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

### Claude Code (personal settings) ###
.claude/settings.local.json

### Operating systems ###
# Linux
.directory
.fuse_hidden*
.nfs*
.Trash-*
# macOS
.DS_Store
._*
# Windows
Thumbs.db
desktop.ini
