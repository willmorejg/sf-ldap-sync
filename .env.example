# Copy to .env and fill in. Never commit .env.

# OpenLDAP (used on first start only, to create the accounts)
LDAP_ADMIN_PASSWORD=change-me-admin
SVC_SYNC_PASSWORD=change-me-sync
SVC_AUTH_PASSWORD=change-me-auth
LOAD_SAMPLES=true
# Sample agency tree + agent for testing without Salesforce (not with the sync)
LOAD_SAMPLE_AGENCIES=false
# With LOAD_SAMPLES=true, also create the confidential OAuth client demo-app
# with this secret (at least 32 characters). Empty: only the public demo-spa.
OAUTH_DEMO_CLIENT_SECRET=

# phpLDAPadmin web UI in the openldap container (http://localhost:8090/)
PHPLDAPADMIN_ENABLED=true

# Token service (auth): public base URL (the token issuer) and access-token audience
AUTH_ISSUER=http://localhost:8081
AUTH_AUDIENCE=acmeinsurance

# Token service OpenAPI document at http://localhost:8081/q/openapi; false stops
# serving it. (The sync service's /openapi is always on; it is loopback-only.)
OPENAPI_ENABLED=true

# Salesforce connected app (client credentials flow). SF_ENABLED=false runs
# without Salesforce (CSV intake only) until these are filled in.
SF_ENABLED=true
SF_LOGIN_URL=https://acmeinsurance--dev.sandbox.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Leave true until a dry-run report looks right, then set false.
DRY_RUN=true
